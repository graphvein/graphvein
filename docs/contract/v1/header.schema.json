{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "contract_version",
    "indexer",
    "repository",
    "generated_at"
  ],
  "properties": {
    "type": {
      "const": "header"
    },
    "contract_version": {
      "const": 1
    },
    "indexer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "commit": {
      "type": "string",
      "minLength": 1
    }
  }
}
