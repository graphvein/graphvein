      {"path": "/api/plain"}
    ],
    "GET /api/files/{*path}": [
      {"path": "/api/files/a/b"}
    ],
    "GET /api/docs/{*slug}": [
      {"path": "/api/docs"},
      {"path": "/api/docs/a/b"}
    ],
    "POST /api/webhook": [
      {"path": "/api/webhook", "json": {"type": "t"}},
      {"path": "/api/webhook", "json": {"type": 1}}
