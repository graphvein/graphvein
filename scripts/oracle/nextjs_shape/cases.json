    "GET /api/review/cfgh": [
      {"path": "/api/review/cfgh", "expect": "200", "expect_header": ["x-config", "1"]}
    ],
    "GET /api/review/cfgx": [
      {"path": "/api/review/cfgx", "expect": "200", "expect_header": ["x-frame-options", "DENY"]}
