{
  "routes": {
    "GET /api/items/{id}": [
      {"path": "/api/items/7?q=a&verbose", "headers": {"authorization": "x"}, "cookies": "theme=dark"},
      {"path": "/api/items/none"},
      {"path": "/api/items/missing"},
      {"path": "/api/items/old"}
    ],
    "PUT /api/items/{id}": [
      {"path": "/api/items/7", "json": {"name": "Lamp", "price": 12, "tags": ["a"]}, "valid": true}
    ],
    "GET /api/search": [
      {"path": "/api/search?term=x&page=1", "headers": {"accept-language": "en"}, "cookies": "session=s"},
      {"path": "/api/search"},
      {"path": "/api/search?term=go"},
      {"path": "/api/search?term=moved"},
      {"path": "/api/search?term=none"},
      {"path": "/api/search?term=next"}
    ],
    "POST /api/forms": [
      {"path": "/api/forms", "form": {"email": "a@b.c", "attachment": "x"}}
    ],
    "POST /api/orders": [
      {"path": "/api/orders", "json": {"sku": "A1", "qty": 2, "note": "n"}, "valid": true, "headers": {"x-request-id": "r1"}},
      {"path": "/api/orders", "json": {"sku": 5}}
    ],
    "PATCH /api/orders": [
      {"path": "/api/orders", "json": {"qty": 1}},
      {"path": "/api/orders", "json": {"qty": 0}}
    ],
    "PUT /api/orders": [
      {"path": "/api/orders", "text": "raw"}
