  "actions": {
    "signup": {"args": [{"email": "a@b.c", "age": 30}], "valid": true, "extra": 5},
    "rename": {"args": [{"id": "1", "name": "n"}]},
    "move": {"args": ["a", 1]},
    "subscribe": {"form": {"email": "a@b.c", "topic": "t"}}
  },
  "schemas": [
    {"file": "app/api/items/[id]/route.ts", "name": "ItemBody", "route": "PUT /api/items/{id}"},
    {"file": "app/api/orders/route.ts", "name": "Order", "route": "POST /api/orders"},
    {"file": "app/api/webhook/route.ts", "name": "Event", "route": "POST /api/webhook"},
    {"file": "app/actions.ts", "name": "Signup", "action": "signup"}
  ],
  "unobservable": {}
}
