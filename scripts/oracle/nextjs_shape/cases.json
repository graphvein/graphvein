    "DELETE /api/orders": [
      {"path": "/api/orders"}
    ],
    "GET /api/deep": [
      {"path": "/api/deep"},
      {"path": "/api/deep", "headers": {"x-bare": "1"}}
    ],
    "GET /admin/stats": [
      {"path": "/admin/stats"},
      {"path": "/admin/stats", "cookies": "admin=1"},
      {"path": "/admin/stats", "cookies": "admin=1", "headers": {"x-scope": "s"}}
    ],
    "GET /api/wrapped": [
      {"path": "/api/wrapped", "headers": {"x-user": "u"}}
    ],
    "GET /api/plain": [
      {"path": "/api/plain"}
