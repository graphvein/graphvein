    "GET /api/review/cfct": [
      {"path": "/api/review/cfct", "expect": "200", "expect_header": ["content-type", {"next14": "text/plain; charset=utf-8, application/json", "next15": "text/plain; charset=utf-8", "next16": "text/plain; charset=utf-8"}]}
    ],
    "POST /api/review/cfct": [
      {"path": "/api/review/cfct", "expect": "202", "expect_header": ["content-type", "text/plain; charset=utf-8"]}
