    "POST /api/loose": [
      {"path": "/api/loose", "json": {"kind": "a"}},
      {"path": "/api/loose", "json": {"kind": "b"}}
    ],
    "GET /api/review/redirects": [
      {"path": "/api/review/redirects", "expect": "500"}
    ],
    "POST /api/review/redirects": [
      {"path": "/api/review/redirects", "expect": "500"}
    ],
    "PUT /api/review/redirects": [
      {"path": "/api/review/redirects", "expect": "307"}
    ],
    "PATCH /api/review/redirects": [
      {"path": "/api/review/redirects", "expect": "308"}
    ],
