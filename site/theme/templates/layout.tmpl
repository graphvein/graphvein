{{define "top"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/style.css">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Description}}">
<meta property="og:type" content="website">
{{- if .OGImage}}
<meta property="og:image" content="{{.OGImage}}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="{{.SiteURL}}{{.URL}}">
{{- end}}
<script src="/assets/site.js"></script>
{{- if .Public}}
<script src="/assets/star.js" defer></script>
{{- end}}
</head>
<body class="page-{{if .Nav}}{{.Nav}}{{else}}plain{{end}}">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="hwrap">
    <a class="brand" href="/"><img src="/assets/logo.svg" width="28" height="28" alt=""><span>Graphvein</span></a>
    <nav class="nav" aria-label="Main">
      <a href="/docs/"{{if eq .Nav "docs"}} aria-current="page"{{end}}>Docs</a>
      <a href="/docs/evidence/"{{if eq .Nav "evidence"}} aria-current="page"{{end}}>Evidence</a>
      <a href="/docs/known-gaps/"{{if eq .Nav "gaps"}} aria-current="page"{{end}}>Known gaps</a>
      <a href="/download/"{{if eq .Nav "download"}} aria-current="page"{{end}}>Download</a>
    </nav>
    <div class="theme" role="group" aria-label="Theme" hidden>
      <button type="button" data-theme-choice="system" aria-pressed="true" title="Theme: System"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M2 3h12v8H2zM6 14h4M8 11v3"/></svg><span class="vh">System</span></button>
      <button type="button" data-theme-choice="light" aria-pressed="false" title="Theme: Light"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"/></svg><span class="vh">Light</span></button>
      <button type="button" data-theme-choice="dark" aria-pressed="false" title="Theme: Dark"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" d="M13.5 9.5A5.5 5.5 0 1 1 6.5 2.5a4.5 4.5 0 0 0 7 7z"/></svg><span class="vh">Dark</span></button>
    </div>
    {{- if .Public}}
    <div class="hgh">
      <a class="gh" href="{{.Repo}}" aria-label="Graphvein on GitHub"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg><span class="gh-t">GitHub</span></a>
      <a class="star" href="{{.Repo}}" data-star-repo="{{.RepoSlug}}" data-star-min="100"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 .8l2.2 4.6 5 .7-3.6 3.5.9 5L8 12.2 3.5 14.6l.9-5L.8 6.1l5-.7z"/></svg><span>Star</span><span class="star-count" hidden></span></a>
    </div>
    {{- end}}
  </div>
</header>
{{end}}

{{define "bottom"}}<footer class="site-footer">
  <div class="fwrap">
    <div class="fbrand"><img src="/assets/logo.svg" width="24" height="24" alt=""><span>Graphvein</span></div>
    <nav class="fnav" aria-label="Footer">
      <a href="/docs/">Docs</a><a href="/docs/evidence/">Evidence</a><a href="/download/">Download</a><a href="/licence/">Licence</a><a href="/changelog/">Changelog</a>
      {{- if .Public}}<a href="{{.Repo}}/issues">Issues</a><a href="{{.Repo}}/discussions">Discussions</a>{{end}}
    </nav>
    <p class="fnote">Apache License {{num "apache-version"}} · {{.Footer}}</p>
  </div>
</footer>
</body>
</html>
{{end}}

{{define "install"}}
<p>{{if not .CloneURL}}<strong>No release yet.</strong> {{end}}{{.Note}}</p>
{{- if .CloneURL}}
<pre class="code"><code>git clone {{.CloneURL}}
{{range .Clone}}{{.}}
{{end}}{{range .Build}}{{.}}   <span class="c"># {{$.BuildNote}}</span>
{{end}}</code></pre>
{{- else}}
<p class="muted">{{.NoSource}}</p>
<pre class="code"><code>{{range .Build}}{{.}}   <span class="c"># {{$.BuildNote}}</span>
{{end}}</code></pre>
{{- end}}
<p>{{.Then}}</p>
<pre class="code"><code>{{range $i, $r := .Run}}{{$r}}{{if or (eq $r "graphvein serve") (eq $r "graphvein serve .")}}   <span class="c"># {{$.ServeNote}}</span>{{end}}
{{end}}</code></pre>
<p class="muted">{{.More}}</p>
{{end}}
