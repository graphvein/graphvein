{
  "openapi": "3.1.0",
  "info": {"title": "Spec shape 3.1", "version": "1"},
  "paths": {
    "/v31/things/{thing_id}": {
      "put": {
        "parameters": [
          {"name": "thing_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "mode", "in": "query", "schema": {"anyOf": [{"type": "string"}, {"type": "null"}]}},
          {"name": "Content-Type", "in": "header", "schema": {"type": "string"}}
        ],
        "requestBody": {
          "content": {
            "application/json": {"schema": {"$ref": "#/components/schemas/Thing"}},
            "application/x-www-form-urlencoded": {"schema": {"$ref": "#/components/schemas/Thing", "description": "form"}}
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Thing", "type": "object"}}}
          },
          "2XX": {"description": "other success"}
        }
      }
    },
    "/v31/auth": {
      "servers": [{"url": "https://api.example.com/"}],
      "get": {
        "security": [
          {"bearer": [], "oidc": ["read", "write"]},
          {"oauth": ["items:read"]},
          {"mtls": []},
          {"undefinedScheme": []},
          {}
        ],
        "responses": {"200": {"description": "ok"}}
      }
    }
  },
