        "type": "object",
        "required": ["id", "label", "roRef"],
        "properties": {
          "id": {"type": "string", "readOnly": true},
          "label": {"type": ["string", "null"]},
          "count": {"type": "integer", "nullable": true},
          "kind": {"enum": ["a", 1, true, null]},
          "choice": {"oneOf": [{"$ref": "#/components/schemas/Thing"}, {"type": "null"}]},
          "roRef": {"oneOf": [{"$ref": "#/components/schemas/RoId"}, {"type": "null"}]},
          "nullBoth": {"oneOf": [{"type": ["string", "null"]}, {"type": "null"}]},
          "nullAny": {"anyOf": [{"type": ["string", "null"]}, {"type": "null"}]},
          "nothing": {"type": "null"},
          "self": {"$ref": "#/components/schemas/Thing"},
          "closed": {"type": "object", "unevaluatedProperties": false},
          "flag": {"const": "on"},
          "any": true,
