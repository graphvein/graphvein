datasource db {
  provider = "cockroachdb"
}

enum Tier {
  FREE
  PAID
}

model Member {
  id     BigInt   @id @default(autoincrement())
  name   String
  tier   Tier     @default(FREE)
  joined DateTime @default(now())
  tags   String[]
  info   Json
  avatar Bytes?
  rank   Int
  ratio  Float
  money  Decimal
  ok     Boolean
  email  String   @unique
  teams  Team[]

  @@unique([rank, ratio])
}

// An implicit many-to-many: its (A, B) key is a unique index (mapped).
model Team {
  id      BigInt   @id
  members Member[]
}
