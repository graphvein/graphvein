# Normalise all text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never touch line endings or attempt text diffs.
*.wasm    binary
*.sqlite  binary
*.db      binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.exe     binary

# Built web UI (web/ is the source; scripts/check-web.sh rebuilds it).
# Collapsed in GitHub diffs; still LF text.
internal/server/ui/static/** linguist-generated=true
